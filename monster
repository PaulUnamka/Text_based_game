    slime_ch = random.randint(1, 3)
    vampire_ch = random.randint(1, 3)
    global monster
    monster = 0
    global goblin
    goblin = 2
    global slime
    slime = 1
    global vampire
    vampire = 3
    if goblin_ch == 3:
        print("A goblin has appeared")
        monster = goblin
    elif slime_ch == 3:
        print("A slime has appeared")
        monster = slime
    elif vampire_ch == 3:
        print("A vampire has appeared")
        monster = vampire
    elif slime_ch == 3 and goblin_ch == 3:
        print("A goblin has appeared")
        monster = goblin
    elif slime_ch == 3 and vampire_ch == 3:
